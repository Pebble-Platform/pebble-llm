{
  "backbone_hf_id": "iic/emotion2vec_base",
  "backbone": "emotion2vec",
  "embed_dim": 768,
  "emotions": [
    "neutral",
    "calm",
    "happy",
    "sad",
    "angry",
    "fearful",
    "disgust",
    "surprised"
  ],
  "distress_emotions": [
    "angry",
    "disgust",
    "fearful",
    "sad"
  ],
  "safety_threshold": 0.72,
  "recall_floor": 0.9,
  "sample_rate": 16000,
  "max_samples": 64000,
  "pooling": "mean",
  "head_dim": 256,
  "safety_head_dim": 64,
  "is_winner": false
}