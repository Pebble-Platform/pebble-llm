# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Experiment tracking ---
WANDB_API_KEY=
WANDB_PROJECT=pebble-emotion-classifier
WANDB_ENTITY=

# --- GCP / Firestore (silver-label ingestion + Gemini backup path) ---
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GCP_PROJECT_ID=
FIRESTORE_TRAINING_COLLECTION=training_data

# --- Gemini backup path (Vertex AI SFT) ---
VERTEX_LOCATION=us-central1
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite

# --- Serving ---
MODEL_CHECKPOINT_PATH=./checkpoints/neobert-multitask/best
SERVING_HOST=0.0.0.0
SERVING_PORT=8080
