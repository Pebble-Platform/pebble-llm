# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.venv-voice/
# uv
.uv/

# Environments / secrets
.env
.env.local
*.key
*.pem
service-account*.json
gcp-credentials*.json

# Data — never commit raw user data or labels (PII / mental-health content)
data/finetuning-message/raw/**
data/finetuning-message/interim/**
data/finetuning-message/processed/**
data/finetuning-message/external/**
data/voice/external/**
!data/**/.gitkeep
# tooling only (NOT data): the dataset viewer + its docs/fetch script
!data/finetuning-message/external/index.html
!data/finetuning-message/external/README.md
!data/finetuning-message/external/download.sh

# Model artifacts & checkpoints
checkpoints/
artifacts/
*.pt
*.bin
*.onnx
*.safetensors
# audio is dataset content — never commit (e.g. Kaggle out/ sample clips)
*.wav

# Vendored NeoBERT modeling code IS committed (pinned revision — protects against
# silent upstream changes). Only model weights are excluded (global *.safetensors rule).

# Experiment tracking
wandb/
mlruns/
outputs/
logs/
*.log

# Notebooks
.ipynb_checkpoints/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Paper PDFs — re-downloadable from arXiv, kept local only
docs/papers/finetuning-message/pdfs/
docs/papers/voice/pdfs/
